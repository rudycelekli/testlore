{
  "name": "testlore",
  "version": "0.1.0",
  "description": "A learning quality engineer: improve, measure, and intelligently route tests with reviewable evidence.",
  "type": "module",
  "bin": {
    "testlore": "src/cli.js",
    "tddswarm": "src/cli.js",
    "tddswarm-codex-agent": "src/adapters/codex.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./playwright": {
      "types": "./src/browser-fixture.d.ts",
      "default": "./src/browser-fixture.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "docs",
    "examples/demo"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "demo": "node src/cli.js demo",
    "benchmark": "node scripts/benchmark.js",
    "benchmark:public": "node scripts/public-benchmark.js",
    "benchmark:defects": "node scripts/generated-defects.js"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rudycelekli/testlore.git"
  },
  "bugs": {
    "url": "https://github.com/rudycelekli/testlore/issues"
  },
  "keywords": [
    "testing",
    "test-impact-analysis",
    "tdd",
    "ai-agents",
    "vitest",
    "jest",
    "developer-tools"
  ],
  "devDependencies": {
    "@bazel/bazelisk": "1.28.1",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "c8": "12.0.0",
    "jest": "30.2.0",
    "vitest": "5.0.2"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
