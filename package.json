{
  "name": "tddswarm",
  "version": "0.1.0",
  "description": "An explainable, local-first test intelligence layer: audit, modularize, and run impacted tests.",
  "type": "module",
  "bin": {
    "tddswarm": "src/cli.js",
    "tddswarm-codex-agent": "src/adapters/codex.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "docs",
    "examples/demo"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "demo": "node src/cli.js demo",
    "benchmark": "node scripts/benchmark.js"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rudycelekli/tddswarm.git"
  },
  "bugs": {
    "url": "https://github.com/rudycelekli/tddswarm/issues"
  },
  "keywords": [
    "testing",
    "test-impact-analysis",
    "tdd",
    "ai-agents",
    "vitest",
    "jest",
    "developer-tools"
  ]
}
