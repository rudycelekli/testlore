      "path": "bounded.test.mjs",
      "content": "import test from 'node:test';\nimport assert from 'node:assert/strict';\nimport { bounded } from './src/bounded.js';\n\ntest('clamps a value below the lower bound', () => {\n  assert.equal(bounded(1, 2, 8), 2);\n});\n\ntest('clamps a value above the upper bound', () => {\n  assert.equal(bounded(9, 2, 8), 8);\n});\n\ntest('preserves the inclusive lower endpoint', () => {\n  assert.equal(bounded(2, 2, 8), 2);\n});\n\ntest('preserves the inclusive upper endpoint', () => {\n  assert.equal(bounded(8, 2, 8), 8);\n});\n\ntest('preserves an interior value', () => {\n  assert.equal(bounded(5, 2, 8), 5);\n});\n\ntest('clamps and preserves values within negative-only bounds', () => {\n  assert.equal(bounded(-10, -8, -2), -8);\n  assert.equal(bounded(-1, -8, -2), -2);\n  assert.equal(bounded(-8, -8, -2), -8);\n  assert.equal(bounded(-2, -8, -2), -2);\n  assert.equal(bounded(-5, -8, -2), -5);\n});\n\ntest('handles negative, zero, and positive values in a range crossing zero', () => {\n  assert.equal(bounded(-5, -3, 4), -3);\n  assert.equal(bounded(6, -3, 4), 4);\n  assert.equal(bounded(-3, -3, 4), -3);\n  assert.equal(bounded(4, -3, 4), 4);\n  assert.equal(bounded(-1, -3, 4), -1);\n  assert.equal(bounded(0, -3, 4), 0);\n  assert.equal(bounded(2, -3, 4), 2);\n});\n\ntest('handles zero as the lower bound', () => {\n  assert.equal(bounded(-1, 0, 3), 0);\n  assert.equal(bounded(0, 0, 3), 0);\n  assert.equal(bounded(1, 0, 3), 1);\n  assert.equal(bounded(3, 0, 3), 3);\n  assert.equal(bounded(4, 0, 3), 3);\n});\n\ntest('handles zero as the upper bound', () => {\n  assert.equal(bounded(-4, -3, 0), -3);\n  assert.equal(bounded(-3, -3, 0), -3);\n  assert.equal(bounded(-1, -3, 0), -1);\n  assert.equal(bounded(0, -3, 0), 0);\n  assert.equal(bounded(1, -3, 0), 0);\n});\n\ntest('handles finite fractional values and bounds exactly', () => {\n  assert.equal(bounded(-2.75, -1.5, 2.25), -1.5);\n  assert.equal(bounded(3.5, -1.5, 2.25), 2.25);\n  assert.equal(bounded(-1.5, -1.5, 2.25), -1.5);\n  assert.equal(bounded(2.25, -1.5, 2.25), 2.25);\n  assert.equal(bounded(-0.75, -1.5, 2.25), -0.75);\n  assert.equal(bounded(1.125, -1.5, 2.25), 1.125);\n});\n\ntest('equal bounds return the bound for a value below it', () => {\n  assert.equal(bounded(-3, -1.5, -1.5), -1.5);\n  assert.equal(bounded(-1, 0, 0), 0);\n  assert.equal(bounded(1, 2, 2), 2);\n});\n\ntest('equal bounds return the bound for a value equal to it', () => {\n  assert.equal(bounded(-1.5, -1.5, -1.5), -1.5);\n  assert.equal(bounded(0, 0, 0), 0);\n  assert.equal(bounded(2, 2, 2), 2);\n});\n\ntest('equal bounds return the bound for a value above it', () => {\n  assert.equal(bounded(1, -1.5, -1.5), -1.5);\n  assert.equal(bounded(1, 0, 0), 0);\n  assert.equal(bounded(3, 2, 2), 2);\n});\n\ntest('reversed bounds throw RangeError for a value below both bounds', () => {\n  assert.throws(() => bounded(-5, 3, -2), RangeError);\n});\n\ntest('reversed bounds throw RangeError for a value between the bounds', () => {\n  assert.throws(() => bounded(0, 3, -2), RangeError);\n});\n\ntest('reversed bounds throw RangeError for a value above both bounds', () => {\n  assert.throws(() => bounded(5, 3, -2), RangeError);\n});\n"
    }
  ]
