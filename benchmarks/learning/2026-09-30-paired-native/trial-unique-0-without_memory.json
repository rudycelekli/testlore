        "files": [
          {
            "path": "test/unique.test.js",
            "content": "import test from 'node:test';\nimport assert from 'node:assert/strict';\nimport { unique } from '../src/unique.js';\n\nconst cases = [\n  {\n    name: 'retains first occurrences of repeated numbers in original order',\n    input: [3, 1, 3, 2, 1, 0, -2, 2, 0, -2],\n    expected: [3, 1, 2, 0, -2],\n  },\n  {\n    name: 'retains first occurrences of repeated strings in original order',\n    input: ['pear', '', 'apple', 'pear', 'Apple', '', 'apple'],\n    expected: ['pear', '', 'apple', 'Apple'],\n  },\n  {\n    name: 'keeps numbers and similarly written strings distinct',\n    input: [1, '1', 1, '2', 2, '1', 0, '0', 2, '2', 0],\n    expected: [1, '1', '2', 2, 0, '0'],\n  },\n  {\n    name: 'returns an empty array for empty input',\n    input: [],\n    expected: [],\n  },\n  {\n    name: 'preserves a singleton number',\n    input: [7],\n    expected: [7],\n  },\n  {\n    name: 'preserves a singleton string',\n    input: ['only'],\n    expected: ['only'],\n  },\n  {\n    name: 'preserves an already-distinct array in its original order',\n    input: ['z', 4, '', -1, '4'],\n    expected: ['z', 4, '', -1, '4'],\n  },\n  {\n    name: 'handles an array consisting entirely of duplicates',\n    input: ['same', 'same', 'same'],\n    expected: ['same'],\n  },\n  {\n    name: 'accepts a frozen input containing duplicates',\n    input: Object.freeze([2, '2', 2, 'first', '2', 'first', 1]),\n    expected: [2, '2', 'first', 1],\n  },\n];\n\nfor (const { name, input, expected } of cases) {\n  test(name, () => {\n    const original = input.slice();\n    const result = unique(input);\n\n    assert.ok(Array.isArray(result), 'result must be an array');\n    assert.notStrictEqual(result, input, 'result must be a new array');\n    assert.deepStrictEqual(result, expected);\n    assert.deepStrictEqual(input, original, 'input must remain unchanged');\n\n    const secondResult = unique(input);\n    assert.ok(Array.isArray(secondResult));\n    assert.notStrictEqual(secondResult, input);\n    assert.notStrictEqual(secondResult, result, 'each call must return a new array');\n    assert.deepStrictEqual(secondResult, expected);\n    assert.deepStrictEqual(input, original);\n\n    result.push('added after the call');\n    assert.deepStrictEqual(input, original, 'changing the result must not change the input');\n    assert.deepStrictEqual(secondResult, expected, 'results must be independent arrays');\n  });\n}\n\nconst invalidInputs = [\n  ['undefined', undefined],\n  ['null', null],\n  ['number', 42],\n  ['string', 'aba'],\n  ['boolean', false],\n  ['object', {}],\n  ['array-like object', { 0: 'a', 1: 'a', length: 2 }],\n];\n\nfor (const [name, input] of invalidInputs) {\n  test(`throws TypeError for ${name}`, () => {\n    assert.throws(() => unique(input), TypeError);\n  });\n}\n"
          }
        ]
