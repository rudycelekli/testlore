esult, input);\n    assert.notStrictEqual(secondResult, result, 'each call must return a new array');\n    assert.deepStrictEqual(secondResult, expected);\n    assert.deepStrictEqual(input, original);\n\n    result.push('added after the call');\n    assert.deepStrictEqual(input, original, 'changing the result must not change the input');\n    assert.deepStrictEqual(secondResult, expected, 'results must be independent arrays');\n  });\n}\n\nconst invalidInputs = [\n  ['undefined', undefined],\n  ['null', null],\n  ['number', 42],\n  ['string', 'aba'],\n  ['boolean', false],\n  ['object', {}],\n  ['array-like object', { 0: 'a', 1: 'a', length: 2 }],\n];\n\nfor (const [name, input] of invalidInputs) {\n  test(`throws TypeError for ${name}`, () => {\n    assert.throws(() => unique(input), TypeError);\n  });\n}\n"
