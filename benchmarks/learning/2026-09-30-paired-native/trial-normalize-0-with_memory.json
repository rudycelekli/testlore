            "path": "test/normalize.test.js",
            "content": "import test from 'node:test';\nimport assert from 'node:assert/strict';\nimport { normalize } from '../src/normalize.js';\n\ntest('trims surrounding whitespace and lowercases letters', () => {\n  assert.equal(normalize('  HeLLo  '), 'hello');\n  assert.equal(normalize('MiXeD'), 'mixed');\n});\n\ntest('preserves internal spaces, tabs, and newlines', () => {\n  assert.equal(normalize(' \\tA  B\\tC\\nD\\r\\n '), 'a  b\\tc\\nd');\n});\n\ntest('returns empty for empty and all-whitespace strings', () => {\n  assert.equal(normalize(''), '');\n  assert.equal(normalize(' \\t\\r\\n '), '');\n});\n\ntest('preserves numbers and punctuation in strings', () => {\n  assert.equal(normalize('123 !?'), '123 !?');\n});\n\nconst invalidInputs = [\n  ['undefined', undefined],\n  ['null', null],\n  ['true', true],\n  ['false', false],\n  ['zero', 0],\n  ['positive number', 42],\n  ['NaN', NaN],\n  ['bigint', 1n],\n  ['symbol', Symbol('x')],\n  ['object', {}],\n  ['array', []],\n  ['function', function () {}],\n  ['boxed string', new String('Hello')],\n];\n\nfor (const [label, value] of invalidInputs) {\n  test(`throws TypeError for ${label}`, () => {\n    assert.throws(() => normalize(value), TypeError);\n  });\n}\n\ntest('throws TypeError when called without arguments', () => {\n  assert.throws(() => normalize(), TypeError);\n});\n"
          }
        ]
